#!/usr/bin/env bash
# nebula-attach — headless attach: apply the flatpak override + LD_PRELOAD hook.
#
# Equivalent to clicking "Attach to Sober" in the GUI. Useful for scripting,
# SSH sessions, or window-manager keybinds.
#
# Usage: nebula-attach [path-to-libnebula_hook.so]
#   (defaults to the .so next to this script, then ~/.local/lib/nebula)
set -euo pipefail

APP_ID="org.vinegarhq.Sober"
SELF_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
QUEUE_DIR="$HOME/.nebula/queue"

# Find the hook library
for candidate in "$SELF_DIR/libnebula_hook.so" \
               "$HOME/.local/lib/nebula/libnebula_hook.so" \
               "/usr/lib/nebula/libnebula_hook.so"; do
    if [ -f "$candidate" ]; then
        HOOK_SO="$(readlink -f "$candidate")"
        break
    fi
done
[ -n "${HOOK_SO:-}" ] || { echo "[nebula] hook .so not found" >&2; exit 1; }

echo "[nebula] stopping any running Sober instances…"
# Kill any running Sober processes to ensure clean state
pkill -f "sober" || true
sleep 1  # Give processes time to terminate

echo "[nebula] resetting previous overrides…"
flatpak override --user --reset "$APP_ID" || true

echo "[nebula] granting sandbox access to $QUEUE_DIR (rw)"
mkdir -p "$QUEUE_DIR"
flatpak override --user --filesystem="$QUEUE_DIR:rw" "$APP_ID"

# The sandbox blocks $HOME entirely — without a hole for the lib's directory,
# LD_PRELOAD points at an unreadable file and the loader silently skips it.
LIB_DIR="$(dirname "$HOOK_SO")"
echo "[nebula] granting sandbox access to $LIB_DIR (ro)"
flatpak override --user --filesystem="$LIB_DIR:ro" "$APP_ID"

echo "[nebula] setting LD_PRELOAD=$HOOK_SO"
flatpak override --user --env=LD_PRELOAD="$HOOK_SO" "$APP_ID"

# Verify the override was applied
echo "[nebula] verifying override…"
OVERRIDE_OUTPUT=$(flatpak override --user --show "$APP_ID" 2>/dev/null || true)
if echo "$OVERRIDE_OUTPUT" | grep -q "LD_PRELOAD=$HOOK_SO"; then
    echo "[nebula] ✦ override verified"
else
    echo "[nebula] ⚠ warning: override may not have been applied correctly"
    echo "[nebula] current override: $OVERRIDE_OUTPUT"
fi

echo
echo "[nebula] ✦ attached. Launch Sober now:"
echo "    flatpak run $APP_ID"
echo
echo "  Console: ~/.nebula/queue/log"
echo "  Tip: If injection fails, completely quit Sober (including tray) and retry"